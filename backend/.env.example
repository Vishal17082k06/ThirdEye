# Copy to .env (git-ignored). Never commit real secrets.

# Signs login tokens. If left blank, an insecure development default is used,
# which is fine locally but must NOT be used in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# "dev" allows the insecure default JWT secret. Leave unset (production) when deploying.
APP_ENV=dev

JWT_SECRET=
DATABASE_URL=sqlite:///./thirdeye.db
# Emergency SOS emails (see README, "Enabling SOS emails"). Leave blank to disable:
# SOS then records a failed attempt with "Email service is not configured".
# GMAIL_USER is the Gmail address that sends the mail. GMAIL_APP_PASSWORD is NOT your
# normal password: create a Google App Password (requires 2-Step Verification) at
# https://myaccount.google.com/apppasswords and paste the 16 characters.
GMAIL_USER=
GMAIL_APP_PASSWORD=
OPENAI_API_KEY=

# Sent to OpenStreetMap services (Nominatim policy requires an identifying User-Agent).
# Put a real contact email in it, e.g. ThirdEye/1.0 (student project; you@example.com)
NOMINATIM_USER_AGENT=
# Demo ride fare rates in INR (not real prices)
RIDE_BASE_FARE_INR=30
RIDE_PER_KM_CAR=14
RIDE_PER_KM_BIKE=8
